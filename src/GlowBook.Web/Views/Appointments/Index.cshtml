@model IEnumerable<Appointment>
@{ ViewData["Title"] = "Записи"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Записи</h2>
    <a class="btn btn-gb-primary btn-sm" asp-action="Create">+ Запись</a>
</div>
<div class="panel">
    @if (!Model.Any()) { <p class="text-muted mb-0">Записей пока нет.</p> }
    else {
        <table class="table table-gb mb-0"><thead><tr><th>Дата</th><th>Клиент</th><th>Услуга</th><th>Статус</th></tr></thead><tbody>
        @foreach (var a in Model) {
            <tr><td>@a.StartsAt.ToString("dd.MM.yyyy HH:mm")</td><td>@a.Client?.Name</td><td>@a.Service?.Name</td><td>@a.Status</td></tr>
        }
        </tbody></table>
    }
</div>
