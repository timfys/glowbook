@model IEnumerable<Appointment>
@{ ViewData["Title"] = "Записи"; }
<div class="page-head">
    <h2 class="h4 fw-bold mb-0">Записи</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-gb-outline btn-sm" asp-action="Calendar">Календарь</a>
        <a class="btn btn-gb-primary btn-sm" asp-action="Create">Новая запись</a>
    </div>
</div>
<div class="panel">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="fw-semibold text-dark mb-1">Записей пока нет</div>
            <p class="mb-3">Создайте первую запись или дождитесь онлайн-заявки от клиента.</p>
            <a class="btn btn-gb-primary btn-sm" asp-action="Create">Добавить запись</a>
        </div>
    }
    else
    {
        <div class="master-appt-list">
        @foreach (var a in Model)
        {
            <div class="master-appt-item">
                <div class="master-appt-main">
                    <div class="master-appt-datetime">@a.StartsAt.ToString("dd.MM.yyyy · HH:mm")</div>
                    <div class="master-appt-client">
                        @if (a.Client != null)
                        {
                            <a asp-controller="Clients" asp-action="Details" asp-route-id="@a.ClientId">@a.Client.Name</a>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(a.Service?.Name))
                    {
                        <div class="master-appt-service">@a.Service.Name</div>
                    }
                </div>
                <div class="master-appt-side">
                    <span class="@DisplayHelpers.StatusClass(a.Status)">@a.Status.DisplayName()</span>
                    <div class="master-appt-actions">
                        @if (a.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed)
                        {
                            <form asp-action="SetStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <input type="hidden" name="status" value="@((int)AppointmentStatus.Completed)" />
                                <button type="submit" class="btn btn-gb-outline btn-sm">Готово</button>
                            </form>
                        }
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Удалить запись?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <button type="submit" class="btn btn-gb-ghost btn-sm text-danger">Удалить</button>
                        </form>
                    </div>
                </div>
            </div>
        }
        </div>
    }
</div>
