@model IEnumerable<Appointment>
@{ ViewData["Title"] = "Записи"; }
<div class="page-head">
    <h2 class="h4 fw-bold mb-0">Записи</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-gb-outline btn-sm" asp-action="Calendar">Календарь</a>
        <a class="btn btn-gb-primary btn-sm" asp-action="Create">Новая запись</a>
    </div>
</div>
<div class="panel">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="fw-semibold text-dark mb-1">Записей пока нет</div>
            <p class="mb-3">Создайте первую запись или дождитесь онлайн-заявки от клиента.</p>
            <a class="btn btn-gb-primary btn-sm" asp-action="Create">Добавить запись</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-gb mb-0">
                <thead><tr><th>Дата</th><th>Клиент</th><th>Услуга</th><th>Статус</th><th></th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.StartsAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (a.Client != null)
                            {
                                <a asp-controller="Clients" asp-action="Details" asp-route-id="@a.ClientId">@a.Client.Name</a>
                            }
                        </td>
                        <td>@a.Service?.Name</td>
                        <td><span class="@DisplayHelpers.StatusClass(a.Status)">@a.Status.DisplayName()</span></td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end align-items-center gap-2">
                                @if (a.Status is AppointmentStatus.Pending or AppointmentStatus.Confirmed)
                                {
                                    <form asp-action="SetStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <input type="hidden" name="status" value="@((int)AppointmentStatus.Completed)" />
                                        <button type="submit" class="btn btn-link btn-sm p-0">Завершить</button>
                                    </form>
                                }
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Удалить запись?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0">Удалить</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
