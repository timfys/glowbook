@using GlowBook.Web.Models.Entities
@model MasterProfile
@{ ViewData["Title"] = "Запись отправлена"; }
<div class="panel mx-auto text-center" style="max-width:480px">
    <h1 class="h4 fw-bold text-success mb-2">Запись принята!</h1>
    <p class="mb-3">Мастер <strong>@Model.BusinessName</strong> свяжется с вами для подтверждения. Регистрация не нужна.</p>
    <a class="btn btn-gb-outline" asp-action="Index" asp-route-slug="@Model.BookingSlug">Вернуться на страницу мастера</a>
</div>
