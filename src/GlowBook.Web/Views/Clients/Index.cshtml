@model IEnumerable<Client>
@{ ViewData["Title"] = "Клиенты"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Клиенты</h2>
    <a class="btn btn-gb-primary btn-sm" asp-action="Create">+ Клиент</a>
</div>
<form method="get" class="mb-3"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Поиск по имени или телефону" /></form>
<div class="panel">
    @if (!Model.Any()) { <p class="text-muted mb-0">Пока нет клиентов.</p> }
    else {
        <table class="table table-gb mb-0"><thead><tr><th>Имя</th><th>Телефон</th><th>Email</th><th>Заметки</th></tr></thead><tbody>
        @foreach (var c in Model) { <tr><td>@c.Name</td><td>@c.Phone</td><td>@c.Email</td><td>@c.Notes</td></tr> }
        </tbody></table>
    }
</div>
