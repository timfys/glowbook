@model IEnumerable<Client>
@{ ViewData["Title"] = "Клиенты"; }
<div class="page-head">
    <h2 class="h4 fw-bold mb-0">Клиенты</h2>
    <a class="btn btn-gb-primary btn-sm" asp-action="Create">Новый клиент</a>
</div>
<form method="get" class="mb-3 search-box">
    <input class="form-control" name="q" value="@ViewBag.Query" placeholder="Поиск по имени, телефону, аллергиям…" />
</form>
<div class="panel">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="fw-semibold text-dark mb-1">Пока нет клиентов</div>
            <p class="mb-3">Добавьте карточку вручную — дальше они будут копиться сами.</p>
            <a class="btn btn-gb-primary btn-sm" asp-action="Create">Добавить клиента</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-gb mb-0">
                <thead><tr><th>Имя</th><th>Телефон</th><th>Проблемы кожи</th><th>Аллергии</th></tr></thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr class="client-row" onclick="location.href='@Url.Action("Details", new { id = c.Id })'" style="cursor:pointer">
                        <td class="fw-semibold"><a asp-action="Details" asp-route-id="@c.Id" class="text-decoration-none text-dark">@c.Name</a></td>
                        <td>@c.Phone</td>
                        <td class="text-muted small">@(c.SkinConcerns ?? "—")</td>
                        <td class="text-muted small">@(c.Allergies ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
