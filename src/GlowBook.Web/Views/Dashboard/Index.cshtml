@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Кабинет";
}

<div class="page-head">
    <div>
        <h2 class="h4 fw-bold mb-0">Сегодня</h2>
        <div class="text-muted small">@DateTime.Today.ToString("dddd, d MMMM")</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-gb-outline btn-sm" asp-controller="Appointments" asp-action="Calendar">Календарь</a>
        <a class="btn btn-gb-primary btn-sm" asp-controller="Appointments" asp-action="Create">Новая запись</a>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value">@ViewBag.TodayCount</div><div class="stat-label">Записей сегодня</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value">@(((decimal)ViewBag.RevenueToday).ToString("N0")) ₽</div><div class="stat-label">Выручка сегодня</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value">@(((decimal)ViewBag.RevenueMonth).ToString("N0")) ₽</div><div class="stat-label">Выручка за месяц</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-value">@ViewBag.ClientsCount</div><div class="stat-label">Клиентов</div></div></div>
</div>
@if (ViewBag.IsPremium == true && ViewBag.BookingUrl != null)
{
    <div class="panel mb-4">
        <div class="fw-semibold mb-1">Ссылка для онлайн-записи</div>
        <code class="user-select-all">@ViewBag.BookingUrl</code>
        <div class="small text-muted mt-1">Отправьте клиентам — они смогут записаться сами.</div>
    </div>
}
<div class="panel">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="fw-semibold text-dark mb-1">На сегодня записей нет</div>
            <p class="mb-3">Добавьте визит вручную или отправьте клиентам ссылку на запись.</p>
            <a class="btn btn-gb-primary btn-sm" asp-controller="Appointments" asp-action="Create">Создать запись</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-gb mb-0">
                <thead><tr><th>Время</th><th>Клиент</th><th>Услуга</th><th>Статус</th></tr></thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="fw-semibold">@a.StartsAt.ToString("HH:mm")</td>
                        <td>
                            @if (a.Client != null)
                            {
                                <a asp-controller="Clients" asp-action="Details" asp-route-id="@a.ClientId">@a.Client.Name</a>
                            }
                        </td>
                        <td>@a.Service?.Name</td>
                        <td><span class="@DisplayHelpers.StatusClass(a.Status)">@a.Status.DisplayName()</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
