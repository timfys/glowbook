@{
    Layout = "_Layout";
    ViewData["Title"] = "Главная";
}

<section class="hero">
    <div class="row align-items-center g-5">
        <div class="col-lg-7">
            <span class="gb-kicker">GlowBook</span>
            <h1>Записи и клиенты — в одном месте</h1>
            <p class="lead mt-3">Ведите расписание, храните контакты и записывайте клиентов через наше приложение.</p>
            <div class="d-flex flex-wrap gap-2 mt-4">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-gb-primary" asp-controller="Dashboard" asp-action="Index">Открыть кабинет</a>
                }
                else
                {
                    <a class="btn btn-gb-primary" asp-controller="Auth" asp-action="Register">Создать аккаунт</a>
                    <a class="btn btn-gb-outline" asp-controller="Auth" asp-action="Login">Войти</a>
                }
            </div>
        </div>
        <div class="col-lg-5">
            <div class="feature-card pricing-card">
                <div class="text-muted small fw-bold mb-2">PREMIUM</div>
                <h5 class="fw-bold mb-1">500 ₽ в месяц</h5>
                <p class="text-muted mb-3">Онлайн-запись по вашей ссылке.</p>
                <ul class="mb-0 ps-3">
                    <li class="mb-1">Страница записи для клиентов</li>
                    <li class="mb-1">Свободные слоты по графику</li>
                    <li class="mb-1">Напоминания — скоро</li>
                    <li>Поддержка</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<div class="row g-3 pb-5">
    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M4 19c.4-3.2 2.5-5 5-5s4.6 1.8 5 5"/></svg>
            </div>
            <h6 class="fw-bold">Клиенты</h6>
            <p class="text-muted mb-0">Карточки, телефоны и заметки — всё под рукой, без таблиц в чатах.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M8 3.5v3M16 3.5v3M3.5 9.5h17"/></svg>
            </div>
            <h6 class="fw-bold">Записи</h6>
            <p class="text-muted mb-0">Расписание визитов со статусами: ожидает, подтверждена, завершена.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3.5 14.2 8l4.8.7-3.5 3.4.8 4.8L12 14.7 7.7 16.9l.8-4.8L5 8.7 9.8 8 12 3.5z"/></svg>
            </div>
            <h6 class="fw-bold">Услуги</h6>
            <p class="text-muted mb-0">Прайс с длительностью и ценой — клиент выбирает услугу сам.</p>
        </div>
    </div>
</div>
