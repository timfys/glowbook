@using GlowBook.Web.Models
@using GlowBook.Web.Models.Enums
@using GlowBook.Web.Services
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@{
    Layout = "_Layout";
    ViewData["Title"] = "Главная";
    var homeUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var cabinetHome = homeUser != null ? AccountRouting.HomeFor(homeUser) : null;
}

<section class="hero home-hero">
    <h1 class="home-brand">GlowBox</h1>
    <p class="home-tagline">Записи и клиенты — в одном месте</p>
    <p class="lead home-lead">CRM для мастеров красоты и удобный поиск мастера для клиентов.</p>
    <div class="home-jump">
        <a class="home-jump-link" href="#home-search">Поиск</a>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <a class="home-jump-link" href="#home-login">Вход</a>
            <a class="home-jump-link" href="#home-register">Регистрация</a>
        }
        else
        {
            <a class="home-jump-link" href="@cabinetHome">Кабинет</a>
        }
    </div>
</section>

<section class="home-block" id="home-search" aria-labelledby="home-search-title">
    <div class="home-block-head">
        <span class="home-block-kicker">Поиск</span>
        <h2 class="home-block-title" id="home-search-title">Найти мастера</h2>
        <p class="home-block-lead">По юзернейму, как в Telegram, или по имени и городу</p>
    </div>
    <form class="home-search" method="get" action="@Url.Action("Index", "Search")">
        <div class="search-field">
            <span class="search-at" aria-hidden="true">@@</span>
            <input type="search" name="q" class="form-control search-input" placeholder="username или имя" autocomplete="off" />
            <button type="submit" class="btn btn-gb-primary search-submit">Найти</button>
        </div>
    </form>
</section>

@if (cabinetHome != null)
{
    <section class="home-block home-block-cabinet">
        <div class="home-block-head">
            <span class="home-block-kicker">Кабинет</span>
            <h2 class="home-block-title">Вы уже вошли</h2>
            <p class="home-block-lead">Откройте рабочее пространство или продолжите поиск мастеров выше</p>
        </div>
        <a class="btn btn-gb-primary" href="@cabinetHome">Открыть кабинет</a>
    </section>
}
else
{
    <div class="home-auth-grid">
        <section class="home-block home-block-login" id="home-login" aria-labelledby="home-login-title">
            <div class="home-block-head">
                <span class="home-block-kicker">Авторизация</span>
                <h2 class="home-block-title" id="home-login-title">Вход</h2>
                <p class="home-block-lead">Уже есть аккаунт — зайдите по email или через Mail.ru</p>
            </div>
            <a class="btn btn-gb-primary w-100" asp-controller="Auth" asp-action="Login">Войти</a>
        </section>

        <section class="home-block home-block-register" id="home-register" aria-labelledby="home-register-title">
            <div class="home-block-head">
                <span class="home-block-kicker">Регистрация</span>
                <h2 class="home-block-title" id="home-register-title">Создать аккаунт</h2>
                <p class="home-block-lead">Выберите, кто вы — и зарегистрируйтесь</p>
            </div>
            <div class="account-type-picker home-role-picker">
                <a class="account-type-option" asp-controller="Auth" asp-action="Register" asp-route-accountType="@UserAccountType.Master">
                    <span class="account-type-title">Мастер</span>
                    <span class="account-type-desc">Кабинет, клиенты, календарь и онлайн-запись</span>
                </a>
                <a class="account-type-option" asp-controller="Auth" asp-action="Register" asp-route-accountType="@UserAccountType.Client">
                    <span class="account-type-title">Клиент</span>
                    <span class="account-type-desc">Мои записи и визиты у мастеров</span>
                </a>
            </div>
        </section>
    </div>
}

<section class="home-premium-strip">
    <div>
        <div class="home-premium-kicker">Premium</div>
        <h2 class="home-premium-title">350 ₽ в месяц</h2>
        <p class="home-premium-lead mb-0">Мини-сайт, онлайн-запись, блог и Яндекс.Карты на вашей странице.</p>
    </div>
    <a class="btn btn-gb-outline btn-sm" href="/rekvizity">Реквизиты и оферта</a>
</section>

<div class="row g-3 pb-5 home-features">
    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"/><path d="M4 19c.4-3.2 2.5-5 5-5s4.6 1.8 5 5"/></svg>
            </div>
            <h6 class="fw-bold">Клиенты</h6>
            <p class="text-muted mb-0">Карточки, телефоны и заметки — всё под рукой, без таблиц в чатах.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M8 3.5v3M16 3.5v3M3.5 9.5h17"/></svg>
            </div>
            <h6 class="fw-bold">Записи</h6>
            <p class="text-muted mb-0">Расписание визитов со статусами: ожидает, подтверждена, завершена.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card h-100">
            <div class="feature-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3.5 14.2 8l4.8.7-3.5 3.4.8 4.8L12 14.7 7.7 16.9l.8-4.8L5 8.7 9.8 8 12 3.5z"/></svg>
            </div>
            <h6 class="fw-bold">Услуги</h6>
            <p class="text-muted mb-0">Прайс с длительностью и ценой — клиент выбирает услугу сам.</p>
        </div>
    </div>
</div>
