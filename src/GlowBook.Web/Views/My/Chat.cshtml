@model GlowBook.Web.Models.Clients.ClientChatViewModel
@{
    ViewData["Title"] = "Чат · " + Model.Title;
}

<div class="page-head">
    <div>
        @if (!string.IsNullOrWhiteSpace(Model.BackUrl))
        {
            <a href="@Model.BackUrl" class="small text-muted text-decoration-none">← Мои мастера</a>
        }
        <h2 class="h4 fw-bold mb-0 mt-1">@Model.Title</h2>
        <div class="text-muted small">Переписка с мастером</div>
    </div>
</div>

@await Html.PartialAsync("_ClientChat", Model)
