@model IEnumerable<GlowBook.Web.Services.ClientAppointmentView>
@using GlowBook.Web.Models.Enums
@using GlowBook.Web.Services
@{
    ViewData["Title"] = "Мои записи";
    var masters = ViewBag.Masters as List<ClientMasterView> ?? new List<ClientMasterView>();
    var filterRecordId = ViewBag.FilterRecordId as int?;
    var upcoming = Model.Where(a => a.StartsAt >= DateTime.Now && a.Status != AppointmentStatus.Cancelled).OrderBy(a => a.StartsAt).ToList();
    var past = Model.Where(a => a.StartsAt < DateTime.Now || a.Status == AppointmentStatus.Cancelled).OrderByDescending(a => a.StartsAt).ToList();
}

<div class="page-head">
    <div>
        <h2 class="h4 fw-bold mb-0">Мои записи</h2>
        <div class="text-muted small">Здесь видны записи, если мастер указал ваш email или телефон</div>
    </div>
    @if (filterRecordId is int rid)
    {
        var m = masters.FirstOrDefault(x => x.ClientRecordId == rid);
        if (m != null)
        {
            <a class="btn btn-gb-outline btn-sm" asp-action="Index">Все записи</a>
        }
    }
</div>

@if (masters.Any())
{
    <div class="panel mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="fw-semibold">Мои мастера</div>
            <a class="small" asp-action="Masters">Все мастера →</a>
        </div>
        <div class="gb-master-grid gb-master-grid-compact">
        @foreach (var m in masters.Take(4))
        {
            var avatarUrl = m.HasAvatar
                ? Url.Action("Avatar", "Profile", new { id = m.MasterProfileId, v = m.AvatarVersion })
                : null;
            <a class="gb-master-card gb-master-card-link panel" asp-action="Index" asp-route-record="@m.ClientRecordId">
                <div class="gb-master-card-head">
                    @if (avatarUrl != null)
                    {
                        <img class="gb-master-card-avatar" src="@avatarUrl" alt="@m.MasterName" />
                    }
                    else
                    {
                        <div class="gb-master-card-avatar gb-master-card-avatar-fallback">@DisplayHelpers.Initials(m.MasterName)</div>
                    }
                    <div>
                        <div class="fw-semibold">@m.MasterName</div>
                        @if (m.UpcomingAppointments > 0)
                        {
                            <div class="small text-muted">@m.UpcomingAppointments предстоящ@(m.UpcomingAppointments == 1 ? "ая" : "их")</div>
                        }
                    </div>
                </div>
            </a>
        }
        </div>
    </div>
}

@if (filterRecordId is int filteredId)
{
    var filteredMaster = masters.FirstOrDefault(x => x.ClientRecordId == filteredId);
    if (filteredMaster != null)
    {
        <div class="alert alert-light border small py-2 mb-3">
            Записи у мастера <strong>@filteredMaster.MasterName</strong>
            · <a asp-action="Chat" asp-route-clientRecordId="@filteredId">Чат</a>
        </div>
    }
}

@if (!Model.Any())
{
    <div class="panel empty-state">
        <div class="fw-semibold mb-1">Записей пока нет</div>
        <p class="text-muted mb-0 small">Попросите мастера указать в карточке клиента тот же email или телефон, что в вашем профиле — записи подтянутся автоматически.</p>
    </div>
}
else
{
    if (upcoming.Any())
    {
        <div class="panel mb-3">
            <div class="fw-semibold mb-3">Предстоящие</div>
            <div class="client-appt-list">
            @foreach (var a in upcoming)
            {
                <div class="client-appt-item">
                    <div>
                        <div class="fw-semibold">@a.StartsAt.ToString("dddd, d MMMM · HH:mm")</div>
                        <div class="small text-muted">@a.ServiceName · @a.MasterName@if (!string.IsNullOrWhiteSpace(a.MasterCity)) { <text>, @a.MasterCity</text> }</div>
                    </div>
                    <span class="@DisplayHelpers.StatusClass(a.Status)">@a.Status.DisplayName()</span>
                </div>
            }
            </div>
        </div>
    }

    if (past.Any())
    {
        <div class="panel">
            <div class="fw-semibold mb-3">История</div>
            <div class="client-appt-list">
            @foreach (var a in past)
            {
                <div class="client-appt-item">
                    <div>
                        <div class="fw-semibold">@a.StartsAt.ToString("d MMMM yyyy · HH:mm")</div>
                        <div class="small text-muted">@a.ServiceName · @a.MasterName</div>
                    </div>
                    <span class="@DisplayHelpers.StatusClass(a.Status)">@a.Status.DisplayName()</span>
                </div>
            }
            </div>
        </div>
    }
}
