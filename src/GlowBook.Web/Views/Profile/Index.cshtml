@model ProfileCardViewModel
@{
    ViewData["Title"] = "Профиль";
    var avatarUrl = Url.Action("Avatar", "Profile", new { id = Model.ProfileId, v = Model.AvatarVersion });
}

<div class="tg-wrap">
    @if (TempData["ProfileSaved"] != null)
    {
        <div class="alert alert-success py-2 px-3 mb-3">Профиль сохранён</div>
    }
    @if (TempData["AvatarError"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-3">@TempData["AvatarError"]</div>
    }
    @if (TempData["UsernameError"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-3">@TempData["UsernameError"]</div>
    }

    <article class="tg-card" style="--book-accent:@Model.AccentColor">
        <div class="tg-card-cover">
            <a class="tg-card-edit" asp-action="Edit" title="Изменить">
                Изменить
            </a>
        </div>

        <div class="tg-card-avatar-wrap">
            <form asp-action="UploadAvatar"
                  method="post"
                  enctype="multipart/form-data"
                  class="profile-avatar-picker profile-avatar-picker-card"
                  data-gb-avatar="1"
                  data-avatar-autosubmit="1"
                  data-has-avatar="@(Model.HasAvatar ? "1" : "0")"
                  data-avatar-url="@(Model.HasAvatar ? avatarUrl : null)"
                  data-remove-url="@Url.Action("RemoveAvatar")"
                  id="avatarQuickForm">
                @Html.AntiForgeryToken()
                @if (Model.HasAvatar)
                {
                    <button type="button"
                            class="profile-avatar-view"
                            aria-label="Фото профиля">
                        <img id="avatarPreview" class="tg-card-avatar" src="@avatarUrl" alt="@Model.DisplayName" />
                    </button>
                }
                else
                {
                    <div id="avatarFallback" class="tg-card-avatar tg-card-avatar-fallback">@DisplayHelpers.Initials(Model.DisplayName)</div>
                    <img id="avatarPreview" class="tg-card-avatar d-none" alt="@Model.DisplayName" />
                }
                <button type="button" class="profile-avatar-camera" data-avatar-change aria-label="Сменить фото">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M4 8h3l1.5-2h7L17 8h3a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.8"/>
                        <circle cx="12" cy="14" r="3.2" stroke="currentColor" stroke-width="1.8"/>
                    </svg>
                </button>
                <input id="avatarInput"
                       name="avatar"
                       type="file"
                       accept="image/*"
                       class="profile-avatar-input-hidden"
                       aria-label="Сменить фото" />
            </form>
            <div class="small text-muted mt-2 ms-1">Нажмите на фото — как в Telegram: открыть, сменить или удалить</div>
            <div id="avatarClientError" class="text-danger small d-none mt-1 ms-1"></div>
        </div>

        <div class="tg-card-body">
            <h1 class="tg-card-name">@Model.DisplayName</h1>
            <div class="gb-username-row mb-1" id="gbUsernameRow">
                <div class="gb-username-display" id="gbUsernameDisplay">
                    <span class="tg-card-sub blog-public-username mb-0">@@@Model.BookingSlug</span>
                    <button type="button" class="gb-username-edit-btn" id="gbUsernameEditBtn">Изменить</button>
                </div>
                <form class="gb-username-form d-none"
                      id="gbUsernameForm"
                      asp-action="UpdateUsername"
                      method="post"
                      autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div class="input-group input-group-sm gb-username-input-group">
                        <span class="input-group-text">@@</span>
                        <input type="text"
                               name="username"
                               class="form-control"
                               value="@Model.BookingSlug"
                               maxlength="32"
                               pattern="[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?"
                               placeholder="maria_glow"
                               autocomplete="username"
                               required />
                        <button type="submit" class="btn btn-gb-primary btn-sm">Сохранить</button>
                        <button type="button" class="btn btn-gb-outline btn-sm" id="gbUsernameCancel">Отмена</button>
                    </div>
                    <div class="form-text">3–32 символа: латиница, цифры, _ и -</div>
                </form>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Specialization))
            {
                <p class="tg-card-sub">@Model.Specialization</p>
            }
            else
            {
                <p class="tg-card-sub">Мастер GlowBox</p>
            }

            <div class="tg-card-chips">
                @if (Model.IsPremium)
                {
                    <span class="badge badge-premium">@Model.PremiumLabel</span>
                }
                else
                {
                    <span class="badge gb-badge-muted">@Model.PremiumLabel</span>
                }
            </div>

            <section class="tg-info">
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="tg-info-row">
                        <div class="tg-info-label">О себе</div>
                        <div class="tg-info-value">@Model.Description</div>
                    </div>
                }
                <div class="tg-info-row">
                    <div class="tg-info-label">Кабинет</div>
                    <div class="tg-info-value">@Model.BusinessName</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                {
                    <div class="tg-info-row">
                        <div class="tg-info-label">Телефон</div>
                        <div class="tg-info-value">@Model.PhoneNumber</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <div class="tg-info-row">
                        <div class="tg-info-label">Email</div>
                        <div class="tg-info-value">@Model.Email</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Location))
                {
                    <div class="tg-info-row">
                        <div class="tg-info-label">Адрес</div>
                        <div class="tg-info-value">@Model.Location</div>
                    </div>
                }
            </section>

            <a class="btn btn-gb-primary w-100 mt-3" asp-action="Edit">Редактировать профиль</a>
            <a class="btn btn-gb-outline w-100 mt-2" asp-controller="Blog" asp-action="Profile" asp-route-username="@Model.BookingSlug" target="_blank" rel="noopener">Публичная страница /u/@Model.BookingSlug</a>
            <a class="btn btn-gb-outline w-100 mt-2" asp-controller="Studio" asp-action="Blog">Блог</a>
            <a class="btn btn-gb-outline w-100 mt-2" asp-controller="Studio" asp-action="Index">Страница для клиентов</a>
            <a class="btn btn-gb-outline w-100 mt-2" asp-controller="Subscription" asp-action="Index">Подписка Premium</a>
        </div>
    </article>
</div>

<script>
(function () {
    var display = document.getElementById('gbUsernameDisplay');
    var form = document.getElementById('gbUsernameForm');
    var editBtn = document.getElementById('gbUsernameEditBtn');
    var cancelBtn = document.getElementById('gbUsernameCancel');
    if (!display || !form || !editBtn || !cancelBtn) return;

    var input = form.querySelector('input[name="username"]');

    function openEdit() {
        display.classList.add('d-none');
        form.classList.remove('d-none');
        if (input) {
            input.focus();
            input.select();
        }
    }

    function closeEdit() {
        form.classList.add('d-none');
        display.classList.remove('d-none');
    }

    editBtn.addEventListener('click', openEdit);
    cancelBtn.addEventListener('click', closeEdit);

    @if (TempData["UsernameError"] != null)
    {
        <text>openEdit();</text>
    }
})();
</script>
