@model IEnumerable<Service>
@{ ViewData["Title"] = "Услуги"; }
<div class="page-head">
    <h2 class="h4 fw-bold mb-0">Услуги</h2>
    <a class="btn btn-gb-primary btn-sm" asp-action="Create">Новая услуга</a>
</div>
<div class="panel">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="fw-semibold text-dark mb-1">Прайс пока пуст</div>
            <p class="mb-3">Добавьте услуги с длительностью и ценой — так проще записывать клиентов.</p>
            <a class="btn btn-gb-primary btn-sm" asp-action="Create">Добавить услугу</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-gb mb-0">
                <thead><tr><th>Название</th><th>Длительность</th><th>Цена</th><th>Статус</th></tr></thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.Name</td>
                        <td>@s.DurationMinutes мин</td>
                        <td>@s.Price.ToString("N0") ₽</td>
                        <td>
                            @if (s.IsActive)
                            {
                                <span class="gb-status gb-status-confirmed">Активна</span>
                            }
                            else
                            {
                                <span class="gb-status gb-status-cancelled">Скрыта</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
