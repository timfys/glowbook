@model IEnumerable<Service>
@{ ViewData["Title"] = "Услуги"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Услуги</h2>
    <a class="btn btn-gb-primary btn-sm" asp-action="Create">+ Услуга</a>
</div>
<div class="panel">
    @if (!Model.Any()) { <p class="text-muted mb-0">Добавьте первую услугу.</p> }
    else {
        <table class="table table-gb mb-0"><thead><tr><th>Название</th><th>Длительность</th><th>Цена</th><th>Статус</th></tr></thead><tbody>
        @foreach (var s in Model) {
            <tr><td>@s.Name</td><td>@s.DurationMinutes мин</td><td>@s.Price.ToString("N0") ₽</td><td>@(s.IsActive ? "Активна" : "Скрыта")</td></tr>
        }
        </tbody></table>
    }
</div>
