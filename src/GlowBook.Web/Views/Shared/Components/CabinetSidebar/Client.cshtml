@model GlowBook.Web.ViewComponents.ClientCabinetSidebarModel
@using GlowBook.Web.Helpers

<aside class="gb-sidebar gb-sidebar-client" id="gbSidebar">
    <div class="gb-sidebar-profile is-static">
        <span class="gb-avatar gb-avatar-fallback">@DisplayHelpers.Initials(Model.DisplayName)</span>
        <span class="gb-sidebar-profile-text">
            <span class="gb-sidebar-profile-name">@Model.DisplayName</span>
            <span class="gb-sidebar-profile-meta">Клиент</span>
        </span>
    </div>

    <nav class="nav flex-column gb-sidebar-nav" aria-label="Кабинет клиента">
        <a class="nav-link @(Model.ActiveController == "My" && Model.ActiveAction == "Index" ? "active" : "")" asp-controller="My" asp-action="Index">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M8 3.5v3M16 3.5v3M3.5 9.5h17"/></svg>
            Мои записи
        </a>
        <a class="nav-link @(Model.ActiveAction == "Masters" ? "active" : "")" asp-controller="My" asp-action="Masters">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.5-3.5 3-5.5 7-5.5s6.5 2 7 5.5"/><path d="M16 3.5l2 2M20 3.5l-2 2"/></svg>
            Мои мастера
        </a>
        <a class="nav-link @(Model.ActiveAction == "Chats" || Model.ActiveAction == "Chat" ? "active" : "")" asp-controller="My" asp-action="Chats">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-4 3V7a2 2 0 0 1 2-2z"/></svg>
            Чаты
        </a>
        <a class="nav-link @(Model.ActiveAction == "Profile" ? "active" : "")" asp-controller="My" asp-action="Profile">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.5-3.5 3-5.5 7-5.5s6.5 2 7 5.5"/></svg>
            Профиль
        </a>
    </nav>
</aside>

<nav class="gb-bottom-nav" id="gbBottomNav" aria-label="Навигация">
    <a class="gb-bottom-nav-item @(Model.ActiveController == "My" && Model.ActiveAction == "Index" ? "active" : "")" asp-controller="My" asp-action="Index">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M8 3.5v3M16 3.5v3M3.5 9.5h17"/></svg>
        <span>Записи</span>
    </a>
    <a class="gb-bottom-nav-item @(Model.ActiveAction == "Masters" ? "active" : "")" asp-controller="My" asp-action="Masters">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.5-3.5 3-5.5 7-5.5s6.5 2 7 5.5"/></svg>
        <span>Мастера</span>
    </a>
    <a class="gb-bottom-nav-item @(Model.ActiveAction == "Chats" || Model.ActiveAction == "Chat" ? "active" : "")" asp-controller="My" asp-action="Chats">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-4 3V7a2 2 0 0 1 2-2z"/></svg>
        <span>Чаты</span>
    </a>
    <a class="gb-bottom-nav-item @(Model.ActiveAction == "Profile" ? "active" : "")" asp-controller="My" asp-action="Profile">
        <span class="gb-bottom-nav-avatar gb-bottom-nav-avatar-fallback">@DisplayHelpers.Initials(Model.DisplayName)</span>
        <span>Профиль</span>
    </a>
</nav>
