@model GlowBook.Web.ViewComponents.CabinetSidebarModel
@using GlowBook.Web.Helpers

<aside class="gb-sidebar" id="gbSidebar">
    <a class="gb-sidebar-profile @(Model.ActiveController == "Profile" ? "is-active" : "")"
       asp-controller="Profile" asp-action="Index">
        @if (Model.Profile.HasAvatar)
        {
            <img class="gb-avatar" src="@Url.Action("Avatar", "Profile", new { id = Model.Profile.Id, v = Model.Profile.AvatarUpdatedAt?.Ticks })" alt="" />
        }
        else
        {
            <span class="gb-avatar gb-avatar-fallback">@DisplayHelpers.Initials(Model.DisplayName)</span>
        }
        <span class="gb-sidebar-profile-text">
            <span class="gb-sidebar-profile-name">@Model.DisplayName</span>
            <span class="gb-sidebar-profile-meta">
                @(string.IsNullOrWhiteSpace(Model.Profile.Specialization) ? Model.Profile.BusinessName : Model.Profile.Specialization)
            </span>
            @if (Model.IsPremium)
            {
                <span class="badge badge-premium mt-1">Premium</span>
            }
        </span>
    </a>

    <nav class="nav flex-column gb-sidebar-nav" aria-label="Кабинет">
        <a class="nav-link @(Model.ActiveController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5z"/></svg>
            Обзор
        </a>
        <a class="nav-link @(Model.ActiveController == "Appointments" ? "active" : "")" asp-controller="Appointments" asp-action="Calendar">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M8 3.5v3M16 3.5v3M3.5 9.5h17"/></svg>
            Календарь
        </a>
        <a class="nav-link @(Model.ActiveController == "Clients" && Model.ActiveAction == "Index" ? "active" : "")" asp-controller="Clients" asp-action="Index">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M4 19c.4-3.2 2.5-5 5-5s4.6 1.8 5 5"/><circle cx="16.5" cy="9" r="2.2"/><path d="M15 19c.2-1.8 1.2-3.1 2.8-3.6 1.8.3 3.2 1.6 3.7 3.6"/></svg>
            Клиенты
        </a>
        <a class="nav-link @(Model.ActiveController == "Clients" && (Model.ActiveAction == "Chats" || Model.ActiveAction == "Chat") ? "active" : "")" asp-controller="Clients" asp-action="Chats">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-4 3V7a2 2 0 0 1 2-2z"/></svg>
            Чаты
        </a>
        <a class="nav-link @(Model.ActiveController == "Services" ? "active" : "")" asp-controller="Services" asp-action="Index">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 14.2 8l4.8.7-3.5 3.4.8 4.8L12 14.7 7.7 16.9l.8-4.8L5 8.7 9.8 8 12 3.5z"/></svg>
            Услуги
        </a>
        <a class="nav-link @(Model.ActiveController == "Subscription" ? "active" : "")" asp-controller="Subscription" asp-action="Index">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V7z"/><path d="M9 7V5.8A3 3 0 0 1 12 3a3 3 0 0 1 3 2.8V7"/></svg>
            Подписка
        </a>
    </nav>
</aside>

<nav class="gb-bottom-nav gb-bottom-nav-many" id="gbBottomNav" aria-label="Навигация">
    <a class="gb-bottom-nav-item @(Model.ActiveController == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5z"/></svg>
        <span>Обзор</span>
    </a>
    <a class="gb-bottom-nav-item @(Model.ActiveController == "Appointments" ? "active" : "")" asp-controller="Appointments" asp-action="Calendar">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M8 3.5v3M16 3.5v3M3.5 9.5h17"/></svg>
        <span>Календарь</span>
    </a>
    <a class="gb-bottom-nav-item @(Model.ActiveController == "Clients" && Model.ActiveAction == "Index" ? "active" : "")" asp-controller="Clients" asp-action="Index">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M4 19c.4-3.2 2.5-5 5-5s4.6 1.8 5 5"/><circle cx="16.5" cy="9" r="2.2"/><path d="M15 19c.2-1.8 1.2-3.1 2.8-3.6 1.8.3 3.2 1.6 3.7 3.6"/></svg>
        <span>Клиенты</span>
    </a>
    <a class="gb-bottom-nav-item @(Model.ActiveController == "Clients" && (Model.ActiveAction == "Chats" || Model.ActiveAction == "Chat") ? "active" : "")" asp-controller="Clients" asp-action="Chats">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-4 3V7a2 2 0 0 1 2-2z"/></svg>
        <span>Чаты</span>
    </a>
    <a class="gb-bottom-nav-item @(Model.ActiveController == "Services" ? "active" : "")" asp-controller="Services" asp-action="Index">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 14.2 8l4.8.7-3.5 3.4.8 4.8L12 14.7 7.7 16.9l.8-4.8L5 8.7 9.8 8 12 3.5z"/></svg>
        <span>Услуги</span>
    </a>
    <a class="gb-bottom-nav-item @(Model.ActiveController == "Profile" || Model.ActiveController == "Subscription" ? "active" : "")" asp-controller="Profile" asp-action="Index">
        @if (Model.Profile.HasAvatar)
        {
            <img class="gb-bottom-nav-avatar" src="@Url.Action("Avatar", "Profile", new { id = Model.Profile.Id, v = Model.Profile.AvatarUpdatedAt?.Ticks })" alt="" />
        }
        else
        {
            <span class="gb-bottom-nav-avatar gb-bottom-nav-avatar-fallback">@DisplayHelpers.Initials(Model.DisplayName)</span>
        }
        <span>Профиль</span>
    </a>
</nav>
