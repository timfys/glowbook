@model Client
<div class="client-contact-bar">
    <span class="client-contact-bar-text">Быстро добавить из телефонной книги</span>
    <button type="button" class="btn btn-gb-outline btn-sm btn-contact-pick" id="pickContactBtn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/><circle cx="12" cy="11" r="3"/><path d="M8 18c.6-2 2.2-3 4-3s3.4 1 4 3"/></svg>
        Из контактов
    </button>
</div>
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" id="clientName" autocomplete="name" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Phone" class="form-label"></label>
    <input asp-for="Phone" class="form-control" id="clientPhone" autocomplete="tel" inputmode="tel" />
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>
