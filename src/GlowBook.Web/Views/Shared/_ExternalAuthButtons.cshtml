@model GlowBook.Web.Models.Auth.AuthProvidersViewModel
@{
    var returnUrl = ViewData["ReturnUrl"] as string;
    if (string.IsNullOrWhiteSpace(returnUrl))
        returnUrl = Context.Request.Query["returnUrl"].ToString();
    if (string.IsNullOrWhiteSpace(returnUrl))
        returnUrl = null;
}

<div class="d-grid gap-2 auth-providers">
@if (Model.MailRu)
{
    <form asp-controller="Auth" asp-action="ExternalLogin" method="post">
        <input type="hidden" name="provider" value="MailRu" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-auth btn-auth-mailru w-100">Продолжить с Mail.ru</button>
    </form>
}
else
{
    <p class="small text-muted mb-0">OAuth Mail.ru не настроен. Нужны ClientId и ClientSecret в User Secrets или appsettings.Development.json</p>
}
</div>
