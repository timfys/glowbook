@inject GlowBook.Web.AssetVersion AssetVersion
@{
    var cabinetControllers = new[] { "Dashboard", "Appointments", "Clients", "Services", "Subscription", "Profile" };
    var isCabinet = User.Identity?.IsAuthenticated == true
        && cabinetControllers.Contains(ViewContext.RouteData.Values["controller"]?.ToString());
    var av = AssetVersion.Value;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <title>@ViewData["Title"] — GlowBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css?av=@av" asp-append-version="true" />
</head>
<body class="gb-app @(isCabinet ? "gb-has-sidebar" : "")">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light gb-nav">
            <div class="@(isCabinet ? "container-fluid px-3 px-lg-4" : "container")">
                @if (isCabinet)
                {
                    <button type="button" class="gb-sidebar-toggle me-2" id="gbSidebarToggle" aria-label="Меню" aria-expanded="false">
                        <span></span><span></span><span></span>
                    </button>
                }
                <a class="navbar-brand gb-logo" asp-controller="Home" asp-action="Index">
                    <span class="gb-logo-mark">G</span>
                    GlowBook
                </a>
                @if (!isCabinet)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                }
                <div class="@(isCabinet ? "ms-auto" : "collapse navbar-collapse")" id="mainNav">
                    @if (!isCabinet && User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Кабинет</a></li>
                        </ul>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    @if (isCabinet)
    {
        <div class="gb-sidebar-backdrop" id="gbSidebarBackdrop"></div>
        @await Component.InvokeAsync("CabinetSidebar")
    }
    <main class="@(isCabinet ? "gb-cabinet-main" : "container gb-page")">
        <div class="@(isCabinet ? "gb-cabinet-content" : null)">
            @RenderBody()
        </div>
    </main>
    <footer class="footer-min text-center">
        GlowBook — CRM для косметологов и мастеров красоты
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js?av=@av" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
