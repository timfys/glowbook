@using Microsoft.AspNetCore.Identity
@using GlowBook.Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-1">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    <li class="nav-item"><span class="nav-link">@(user?.DisplayName ?? user?.Email)</span></li>
    <li class="nav-item">
        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="nav-link btn btn-link">Выйти</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Register">Регистрация</a></li>
    <li class="nav-item"><a class="btn btn-gb-primary btn-sm ms-1" asp-controller="Auth" asp-action="Login">Войти</a></li>
}
</ul>
