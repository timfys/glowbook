@using Microsoft.AspNetCore.Identity
@using GlowBook.Web.Models
@using GlowBook.Web.Models.Enums
@using GlowBook.Web.Helpers
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject GlowBook.Web.Services.MasterProfileService Profiles

<ul class="navbar-nav align-items-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var isClient = user?.AccountType == UserAccountType.Client;
    var profile = !isClient && user != null ? await Profiles.GetForUserAsync(user.Id) : null;
    var name = user?.DisplayName ?? user?.Email ?? "Профиль";
    var profileUrl = isClient ? Url.Action("Profile", "My") : Url.Action("Index", "Profile");
    <li class="nav-item">
        <a class="gb-nav-user" href="@profileUrl" title="Мой профиль">
            @if (profile?.HasAvatar == true)
            {
                <img class="gb-avatar gb-avatar-sm" src="@Url.Action("Avatar", "Profile", new { id = profile.Id, v = profile.AvatarUpdatedAt?.Ticks })" alt="" />
            }
            else
            {
                <span class="gb-avatar gb-avatar-sm gb-avatar-fallback">@DisplayHelpers.Initials(name)</span>
            }
            <span class="gb-nav-user-name">@name</span>
        </a>
    </li>
    <li class="nav-item">
        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-gb-ghost btn-sm">Выйти</button>
        </form>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Register">Регистрация</a></li>
    <li class="nav-item"><a class="btn btn-gb-primary btn-sm ms-1" asp-controller="Auth" asp-action="Login">Войти</a></li>
}
</ul>
