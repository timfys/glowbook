@model GlowBook.Web.Models.Studio.StudioPageViewModel
@using GlowBook.Web.Services
@{ ViewData["Title"] = "Страница для клиентов"; }
<div class="page-head">
    <div>
        <h2 class="h4 fw-bold mb-0">Страница для клиентов</h2>
        <p class="text-muted small mb-0">Мини-сайт: портфолио, акции, отзывы и карта</p>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.BookingUrl))
    {
        <a class="btn btn-gb-outline btn-sm" href="@Model.BookingUrl" target="_blank" rel="noopener">Открыть страницу</a>
    }
</div>

@if (TempData["StudioSaved"] is string saved)
{
    <div class="alert alert-success py-2 px-3">@saved</div>
}
@if (TempData["StudioError"] is string error)
{
    <div class="alert alert-danger py-2 px-3">@error</div>
}

@if (!string.IsNullOrWhiteSpace(Model.BookingUrl))
{
    <div class="panel mb-3">
        <div class="small text-muted mb-1">Ссылка для клиентов</div>
        <code class="user-select-all">@Model.BookingUrl</code>
    </div>
}

<div class="panel mb-3">
    <h3 class="h6 fw-bold mb-3">Оформление</h3>
    <form asp-action="SaveAppearance" method="post">
        @Html.AntiForgeryToken()
        <label class="form-label">Цвет страницы</label>
        <partial name="_ColorSwatches" model="Model.AccentColor" />
        <input type="hidden" name="accentColor" id="accentColor" value="@Model.AccentColor" />
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" name="showOnMap" value="true" id="showOnMap" @(Model.ShowOnMap ? "checked" : null) />
            <label class="form-check-label" for="showOnMap">Показывать кабинет на Яндекс.Картах</label>
        </div>
        @if (string.IsNullOrWhiteSpace(Model.Location))
        {
            <p class="small text-muted mt-2 mb-0">Сначала укажите город и адрес в <a asp-controller="Profile" asp-action="Edit">профиле</a>.</p>
        }
        else
        {
            <p class="small text-muted mt-2 mb-0">Сейчас: @Model.Location</p>
        }
        <button type="submit" class="btn btn-gb-primary btn-sm mt-3">Сохранить оформление</button>
    </form>
    <p class="small text-muted mt-3 mb-0">
        Чтобы новые клиенты находили вас в поиске карт, добавьте организацию в
        <a href="@MapUrls.AddOrganization" target="_blank" rel="noopener">Яндекс Бизнес</a>.
    </p>
</div>

<div class="panel mb-3">
    <h3 class="h6 fw-bold mb-3">Портфолио</h3>
    @if (Model.Portfolio.Any())
    {
        <div class="book-portfolio mb-3">
            @foreach (var photo in Model.Portfolio)
            {
                var src = Url.Action("Photo", "Studio", new { id = photo.Id });
                <figure class="book-portfolio-item">
                    <img src="@src" alt="@(photo.Caption ?? "Работа")" />
                    @if (!string.IsNullOrWhiteSpace(photo.Caption))
                    {
                        <figcaption>@photo.Caption</figcaption>
                    }
                    <form asp-action="DeletePortfolio" asp-route-id="@photo.Id" method="post" class="mt-1" onsubmit="return confirm('Удалить фото?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-gb-ghost btn-sm text-danger">Удалить</button>
                    </form>
                </figure>
            }
        </div>
    }
    <form asp-action="AddPortfolio" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Фото работы</label>
                <input type="file" name="photo" accept="image/*" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Подпись</label>
                <input type="text" name="caption" class="form-control" maxlength="200" placeholder="Маникюр, окрашивание…" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-gb-primary w-100">Добавить</button>
            </div>
        </div>
    </form>
</div>

<div class="panel mb-3">
    <h3 class="h6 fw-bold mb-3">Акции</h3>
    @if (Model.Promos.Any())
    {
        <div class="master-appt-list mb-3">
            @foreach (var promo in Model.Promos)
            {
                <div class="master-appt-item">
                    <div class="master-appt-main">
                        <div class="master-appt-datetime">
                            @promo.Title
                            @if (!string.IsNullOrWhiteSpace(promo.Badge))
                            {
                                <span class="book-promo-badge ms-1">@promo.Badge</span>
                            }
                        </div>
                        <div class="master-appt-service">
                            @(promo.Description ?? "Без описания")
                            @if (promo.ValidUntil != null)
                            {
                                <span>· до @promo.ValidUntil.Value.ToString("dd.MM.yyyy")</span>
                            }
                        </div>
                    </div>
                    <div class="master-appt-side">
                        <span class="gb-status @(promo.IsActive ? "gb-status-confirmed" : "gb-status-cancelled")">@(promo.IsActive ? "На сайте" : "Скрыта")</span>
                        <div class="master-appt-actions">
                            <form asp-action="TogglePromo" asp-route-id="@promo.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-gb-outline btn-sm">@(promo.IsActive ? "Скрыть" : "Показать")</button>
                            </form>
                            <form asp-action="DeletePromo" asp-route-id="@promo.Id" method="post" onsubmit="return confirm('Удалить акцию?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-gb-ghost btn-sm text-danger">Удалить</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    <form asp-action="AddPromo" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-2">
            <div class="col-md-4">
                <label asp-for="Promo.Title" class="form-label"></label>
                <input asp-for="Promo.Title" class="form-control" placeholder="Скидка на окрашивание" />
            </div>
            <div class="col-md-2">
                <label asp-for="Promo.Badge" class="form-label"></label>
                <input asp-for="Promo.Badge" class="form-control" placeholder="-20%" />
            </div>
            <div class="col-md-3">
                <label asp-for="Promo.ValidUntil" class="form-label"></label>
                <input asp-for="Promo.ValidUntil" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Promo.Description" class="form-label"></label>
                <input asp-for="Promo.Description" class="form-control" placeholder="На любую услугу до конца месяца" />
            </div>
        </div>
        <button type="submit" class="btn btn-gb-primary btn-sm mt-3">Добавить акцию</button>
    </form>
</div>

<div class="panel">
    <h3 class="h6 fw-bold mb-3">Отзывы</h3>
    @if (!Model.Reviews.Any())
    {
        <p class="text-muted mb-0">Клиенты оставляют отзывы на публичной странице. Если у человека уже был завершённый визит, отзыв публикуется сразу.</p>
    }
    else
    {
        <div class="master-appt-list">
            @foreach (var review in Model.Reviews)
            {
                <div class="master-appt-item">
                    <div class="master-appt-main">
                        <div class="master-appt-datetime">@review.AuthorName · @(new string('★', review.Rating))</div>
                        <div class="master-appt-service">@review.Text</div>
                        <div class="small text-muted">@review.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy") · @review.AuthorPhone</div>
                    </div>
                    <div class="master-appt-side">
                        <span class="gb-status @(review.IsPublished ? "gb-status-confirmed" : "gb-status-pending")">@(review.IsPublished ? "На сайте" : "На модерации")</span>
                        <div class="master-appt-actions">
                            <form asp-action="PublishReview" asp-route-id="@review.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="publish" value="@((!review.IsPublished).ToString().ToLowerInvariant())" />
                                <button type="submit" class="btn btn-gb-outline btn-sm">@(review.IsPublished ? "Скрыть" : "Опубликовать")</button>
                            </form>
                            <form asp-action="DeleteReview" asp-route-id="@review.Id" method="post" onsubmit="return confirm('Удалить отзыв?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-gb-ghost btn-sm text-danger">Удалить</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.color-swatch input').forEach(function (input) {
            input.addEventListener('change', function () {
                var hidden = document.getElementById('accentColor');
                if (hidden) hidden.value = input.value;
                document.querySelectorAll('.color-swatch').forEach(function (el) { el.classList.remove('is-selected'); });
                input.closest('.color-swatch')?.classList.add('is-selected');
            });
        });
    </script>
}
