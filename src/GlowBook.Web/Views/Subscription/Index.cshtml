@model Subscription
@{
    ViewData["Title"] = "Подписка";
    var price = (int?)ViewBag.PremiumPrice ?? 350;
    var bookingUrl = ViewBag.BookingUrl as string;
    var yookassaOk = ViewBag.YooKassaConfigured == true;
    var daysLeft = DisplayHelpers.PremiumDaysLeft(Model?.ExpiresAt);
}
<div class="panel pricing-card" style="max-width:640px">
    <h2 class="h4 fw-bold">GlowBox Premium</h2>
    @if (TempData["PaySuccess"] != null || ViewBag.PaySuccess != null)
    {
        <div class="alert alert-success">Оплата прошла. Вы Premium-пользователь@(Model?.ExpiresAt != null ? " до " + DisplayHelpers.PremiumUntilDate(Model.ExpiresAt) : "").</div>
    }
    @if (TempData["PayPending"] != null)
    {
        <div class="alert alert-warning">Платёж ещё обрабатывается. Как только ЮKassa пришлёт подтверждение, здесь появится Premium и дата окончания.</div>
    }
    @if (ViewBag.PayError != null)
    {
        <div class="alert alert-danger">@ViewBag.PayError</div>
    }
    @if (Model?.IsPremiumActive == true)
    {
        <div class="premium-status-card mb-3">
            <div>
                <div class="premium-status-kicker">Статус</div>
                <div class="premium-status-title">Вы Premium-пользователь</div>
                <div class="premium-status-until">до @DisplayHelpers.PremiumUntilDate(Model.ExpiresAt)</div>
                @if (daysLeft != null)
                {
                    <div class="small mt-1" style="opacity:.85">осталось @daysLeft дн.</div>
                }
            </div>
            <span class="badge badge-premium">Premium</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(bookingUrl))
        {
            <div class="mt-3 p-3 rounded-3 gb-highlight-box">
                <div class="small text-muted mb-1">Ссылка для клиентов</div>
                <code class="user-select-all">@bookingUrl</code>
            </div>
        }
        <p class="small mt-3 mb-0"><a href="/rekvizity">Реквизиты и оферта</a></p>
    }
    else
    {
        <p class="text-muted">Сейчас бесплатный тариф. Premium — <strong>@price ₽/мес</strong>.</p>
        @if (!string.IsNullOrWhiteSpace(bookingUrl))
        {
            <div class="mt-3 mb-3 p-3 rounded-3 gb-highlight-box">
                <div class="small text-muted mb-1">Ссылка для клиентов — пока без Premium</div>
                <code class="user-select-all">@bookingUrl</code>
            </div>
        }
        <ul class="mb-4">
            <li>Мини-сайт мастера: портфолио, отзывы, акции и оформление</li>
            <li>Онлайн-запись по ссылке без регистрации клиента</li>
            <li>Кабинет на Яндекс.Картах</li>
            <li>SMS/Telegram-напоминания (скоро)</li>
        </ul>
        @if (yookassaOk)
        {
            <form asp-action="Pay" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-gb-primary">Оплатить @price ₽ через ЮKassa</button>
            </form>
        }
        else
        {
            <button class="btn btn-gb-primary" disabled>Оплатить @price ₽</button>
            <p class="small text-muted mt-2 mb-0">Добавьте ключи ЮKassa в User Secrets (см. README).</p>
        }
        <p class="small mt-3 mb-0"><a href="/rekvizity">Реквизиты и оферта</a></p>
    }
</div>
